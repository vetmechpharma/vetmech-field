# Use a dedicated database and a dedicated readWrite application user.
# Percent-encode special characters in the password. Never commit .env.
MONGODB_URI=mongodb://vetmech_app:REPLACE_PASSWORD@localhost:27017/vetmech_field?authSource=vetmech_field&replicaSet=rs0
MONGODB_DB=vetmech_field
APP_ORIGIN=https://mr.example.com
PORT=3010
NEXT_TELEMETRY_DISABLED=1
# Optional. Keep blank until your gateway is configured.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION=primary
