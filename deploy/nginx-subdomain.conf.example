# Replace mr.example.com with your chosen subdomain.
# Separate file: /etc/nginx/sites-available/vetmech-field
# Leave the existing primary-domain server block and its port 8001 unchanged.
server {
    listen 80;
    server_name mr.example.com;
    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        client_max_body_size 2m;
        proxy_read_timeout 120s;
    }
}
# Obtain HTTPS using Certbot's nginx plugin after DNS resolves to this server.
# HTTPS is required before using login or GPS. Port 3010 remains private.
